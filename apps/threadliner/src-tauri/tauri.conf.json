{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThreadLiner",
  "version": "2.2.5",
  "identifier": "com.threadline.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5251",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "News",
    "shortDescription": "RSS reader with Git sync",
    "longDescription": "ThreadLiner is an RSS 2.0, Atom, and JSON Feed reader that stores its data as Git-synced JSON.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  }
}
