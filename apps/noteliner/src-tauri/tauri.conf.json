{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteLiner",
  "version": "2.2.5",
  "identifier": "com.nathanlaan.noteliner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5250",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Outliner-style Markdown notes with git sync",
    "longDescription": "NoteLiner organises Markdown notes in a hierarchy, auto-commits every change to git, and can expose the open project to AI assistants over a local MCP server.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  }
}
