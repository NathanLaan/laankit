{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PageLiner",
  "version": "2.2.5",
  "identifier": "com.pageliner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5253",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "E-reader and document library",
    "longDescription": "PageLiner manages a library of EPUB and PDF documents with reading-position persistence, bookmarks, highlights, and optional Git sync.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  }
}
