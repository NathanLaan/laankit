{
  "name": "pageliner",
  "version": "2.2.5",
  "description": "A desktop e-reader and document library built with Electron, Svelte, and optional Git-synced JSON",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "bundle:preload": "esbuild src/main/preload.js --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload.cjs",
    "prebuild": "npm run bundle:preload",
    "build": "vite build",
    "build:renderer": "vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:icons": "bash scripts/build-icons.sh",
    "build:linux": "npm run build && npm run build:icons && electron-builder --linux",
    "build:win": "npm run build && npm run build:icons && electron-builder --win",
    "build:mac": "npm run build && npm run build:icons && electron-builder --mac",
    "build:all": "npm run build && npm run build:icons && electron-builder -mwl",
    "electron:dev": "node scripts/dev.js",
    "start": "electron --class=PageLiner ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@marina/desktop-ui": "*",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38"
  },
  "build": {
    "appId": "com.pageliner.app",
    "productName": "PageLiner",
    "files": [
      "src/main/**/*",
      "!src/main/preload.js",
      "dist/preload.cjs",
      "dist/renderer/**/*",
      "assets/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;Viewer"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
