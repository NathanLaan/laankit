<?xml version="1.0" encoding="UTF-8"?>
<!-- Mermaid diagrams (*.mmd), so file managers offer BlockLiner for them.
     Installed as /usr/share/mime/packages/com.blockliner.app.xml. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/vnd.mermaid">
    <comment>Mermaid diagram</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.mmd"/>
    <glob pattern="*.mermaid"/>
  </mime-type>
</mime-info>
