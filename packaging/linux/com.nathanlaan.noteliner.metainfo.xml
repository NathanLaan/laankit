<component type="desktop-application">
  <id>com.nathanlaan.noteliner</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>NoteLiner</name>
  <summary>Outliner-style Markdown notes in a plain folder</summary>
  <developer id="com.nathanlaan">
    <name>Nathan Laan</name>
  </developer>
  <description>
    <p>
      NoteLiner organizes Markdown notes in folders. A project is a plain
      folder of files that you open and edit, and deleted notes go to the trash.
    </p>
    <ul>
      <li>A Markdown editor with highlighting, list editing, find and spell check</li>
      <li>Folders, wikilinks, backlinks, tags and search</li>
      <li>Attachments, templates, DOCX/PPTX import and PDF/HTML export</li>
      <li>Slides from notes, with a full-screen presenter</li>
      <li>An MCP server so AI clients can read and edit notes, with confirmation</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.nathanlaan.noteliner.desktop</launchable>
  <provides>
    <binary>noteliner</binary>
  </provides>
