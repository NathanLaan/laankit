<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.threadline.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>ThreadLiner</name>
  <summary>Feed reader with git sync</summary>
  <developer id="com.nathanlaan">
    <name>Nathan Laan</name>
  </developer>
  <description>
    <p>
      ThreadLiner reads RSS 2.0, Atom and JSON Feed. Feeds, tags and read state
      are stored as JSON in a git repository and synced across machines.
    </p>
    <ul>
      <li>Feeds and tags with unread counts</li>
      <li>Articles rendered natively, with links opened in the browser</li>
      <li>Background polling and notifications for new entries</li>
      <li>Git sync with a remote of your choice</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.threadline.app.desktop</launchable>
  <provides>
    <binary>threadliner</binary>
  </provides>
  <url type="homepage">https://github.com/NathanLaan/laankit</url>
  <url type="bugtracker">https://github.com/NathanLaan/laankit/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="2.3.1" date="2026-10-30"/>
    <release version="2.2.5" date="2026-10-18"/>
    <release version="2.0.1" date="2026-10-18"/>
  </releases>
</component>
