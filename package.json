{
  "name": "marina",
  "version": "2.0.1",
  "private": true,
  "workspaces": ["packages/*", "packages/desktop-ui/examples/*", "apps/*"],
  "scripts": {
    "build":                "npm run build -ws --if-present",
    "dev:noteliner":        "npm run dev -w noteliner",
    "dev:threadliner":      "npm run dev -w threadliner",
    "dev:pageliner":        "npm run dev -w pageliner",
    "electron:noteliner":   "npm run electron:dev -w noteliner",
    "tauri:noteliner":      "npm run tauri:dev -w noteliner",
    "electron:threadliner": "npm run electron:dev -w threadliner",
    "tauri:threadliner":    "npm run tauri:dev -w threadliner",
    "native:threadliner":   "cargo run -p threadliner-native --release",
    "electron:pageliner":   "npm run electron:dev -w pageliner",
    "tauri:pageliner":      "npm run tauri:dev -w pageliner",
    "playground":           "npm run electron:dev -w @marina/desktop-ui-playground",
    "build:noteliner":      "npm run build -w noteliner",
    "build:threadliner":    "npm run build -w threadliner",
    "build:pageliner":      "npm run build -w pageliner",
    "icons:rasterize":      "npm run icons:rasterize:noteliner && npm run icons:rasterize:threadliner && npm run icons:rasterize:pageliner",
    "icons:rasterize:noteliner":   "electron scripts/rasterize-icon.js apps/noteliner/assets/icon.svg apps/noteliner/assets/icon.png 512",
    "icons:rasterize:threadliner": "electron scripts/rasterize-icon.js apps/threadliner/assets/icon.svg apps/threadliner/assets/icon.png 512",
    "icons:rasterize:pageliner":   "electron scripts/rasterize-icon.js apps/pageliner/assets/icon.svg apps/pageliner/assets/icon.png 512"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "electron": "41.10.7",
    "esbuild": "^0.28.2",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "@tauri-apps/cli": "^2.12.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  }
}